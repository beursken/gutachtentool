<Project Sdk="Microsoft.NET.Sdk.Razor">
  <!-- Gemeinsame Oberfläche (Blazor-Komponenten) der Browser-Fassung (Gutachtentool.Web, WebAssembly)
       und der Mac-Fassung (Gutachtentool.Mac, natives Fenster mit WebKit). Plattformteile: IPlattform. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Gutachtentool.Oberflaeche</RootNamespace>
    <Version>1.4.0</Version>
    <Product>Gutachtentool</Product>
    <Company>Universität Passau</Company>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gutachten2025.Core\Gutachten2025.Core.csproj" />
  </ItemGroup>
</Project>
