@using System.ComponentModel
@using System.Windows.Input
@using CommunityToolkit.Mvvm.Input
@implements IAsyncDisposable
@inject IPlattform Plattform
@inject UiDienst Ui
@inject EntwurfEditor Editor
@inject IJSRuntime Js

<div class="app">
    <header class="kopf">
        <div class="marke" title="Gutachtentool @Fassung – @(Plattform.ImBrowser ? "Browser-Fassung" : "Mac-Fassung")">
            <img src="favicon.png" alt="" width="20" height="20" />
            <span>Gutachtentool</span>
        </div>

        @if (_vm is not null)
        {
            <div class="feldgruppe klausurwahl">
                <label for="f-klausur">Klausur</label>
                <select id="f-klausur" value="@_vm.KlausurName" @onchange="e => KlausurWaehlen(e.Value as string)">
                    @if (_vm.KeineKlausur)
                    {
                        <option value="">– bitte wählen –</option>
                    }
                    @foreach (string k in _vm.Klausuren)
                    {
                        <option value="@k">@k</option>
                    }
                </select>
                <button class="knopf leise" @onclick="NeueKlausurAsync" title="Neue Klausur anlegen">Neu …</button>
            </div>

            <nav class="menues">
                <div class="menue">
                    <button class="knopf leise @(_menue == "klausur" ? "aktiv" : "")" @onclick='() => MenueUmschalten("klausur")'>Klausur ▾</button>
                    @if (_menue == "klausur")
                    {
                        <div class="menueliste" @onclick="() => _menue = null">
                            <button @onclick="() => Los(_vm.KonfigurationBearbeitenCommand)">Klausureinstellungen …</button>
                            @if (!Plattform.ImBrowser)
                            {
                                <button @onclick="() => Los(_vm.OrdnerOeffnenCommand)">Klausurordner im Finder zeigen</button>
                            }
                            <hr />
                            <button @onclick="() => Los(_vm.NotenlisteOeffnenCommand)">Notenliste @Oeffnen</button>
                            <button @onclick="() => Los(_vm.ErwartungshorizontOeffnenCommand)">Erwartungshorizont @Oeffnen</button>
                            <button @onclick="() => Los(_vm.TeilnehmendeImportierenCommand)">Teilnehmendenliste @Laden …</button>
                            <button @onclick="() => Los(_vm.KennziffernEingebenCommand)" title="Bereich (z. B. 1001-1060) oder Liste; nicht vergebene entfernen">Kennziffern eingeben …</button>
                            <button @onclick="() => Los(_vm.KlausurenportalExportierenCommand)" title="Notenliste und vorhandene Gutachten-PDFs als ZIP für das Prüfungsportal">Export für das Prüfungsportal (ZIP)</button>
                            <hr />
                            <button @onclick="() => Los(_vm.VorlageBearbeitenCommand)">Word-Vorlage @Oeffnen</button>
                            <button @onclick="() => Los(_vm.VorlageImportierenCommand)">Word-Vorlage @Laden …</button>
                            <button @onclick="() => Los(_vm.FormulierungenBearbeitenCommand)">Textbausteine (Texte.txt) @Oeffnen</button>
                            <button @onclick="() => Los(_vm.FormulierungenImportierenCommand)">Textbausteine @Laden …</button>
                            <button @onclick="() => Los(_vm.RohpunkteInExcelBearbeitenCommand)">Rohpunkteschema in Excel @Oeffnen</button>
                            <button @onclick="() => Los(_vm.RohpunkteImportierenCommand)">Rohpunkteschema @Laden …</button>
                            <hr />
                            <button @onclick="() => Los(_vm.KlausurinformationenVorbereitenCommand)" title="Im KI-Portal aus Sachverhalt und Lösung ein Paket erzeugen">Klausurinformationen vorbereiten (KI-Portal)</button>
                            <button @onclick="() => Los(_vm.BausteinstatistikSendenCommand)" title="Nur Bausteine und Zahl der Gutachten – keine Kennziffern oder Texte">Bausteinstatistik an das KI-Portal senden …</button>
                            <button @onclick="() => Los(_vm.PaketImportierenWaehlenCommand)">Paket (.gtpaket) öffnen …</button>
                            <button @onclick="() => Los(_vm.PaketExportierenCommand)">Paket für Zweitkorrektur erstellen</button>
                        </div>
                    }
                </div>
                @if (Plattform is IBrowserSicherung)
                {
                <div class="menue">
                    <button class="knopf leise @(_menue == "daten" ? "aktiv" : "")" @onclick='() => MenueUmschalten("daten")'>Daten ▾</button>
                    @if (_menue == "daten")
                    {
                        <div class="menueliste rechts" @onclick="() => _menue = null">
                            <button @onclick="SicherungHerunterladen">Sicherung herunterladen (ZIP)</button>
                            <button @onclick="SicherungEinspielenAsync">Sicherung einspielen …</button>
                            <hr />
                            <div class="menuetext">
                                Alle Daten liegen nur in diesem Browser auf diesem Rechner.
                                Löschen der Browserdaten löscht auch Klausuren und Gutachten – bitte regelmäßig sichern.
                                @if (_belegung is { } b)
                                {
                                    <br /><span>Belegt: @Groesse(b.Belegt) von @Groesse(b.Verfuegbar)</span>
                                }
                            </div>
                        </div>
                    }
                </div>
                }
                else
                {
                    <button class="knopf leise" @onclick="() => Los(_vm.AblageordnerWaehlenCommand)" title="@_vm.AblageordnerText">Ablageordner …</button>
                }
                <button class="knopf leise @(_vm.SeitenleisteOffen ? "aktiv" : "")" @onclick="() => _vm.SeitenleisteOffen = !_vm.SeitenleisteOffen" title="Übersicht ein-/ausblenden">Übersicht</button>
            </nav>
        }
    </header>

    @if (_menue is not null)
    {
        <div class="menueschutz" @onclick="() => _menue = null"></div>
    }

    <div class="arbeitsflaeche @(_vm?.SeitenleisteOffen == true ? "mit-uebersicht" : "")">
        @* ---------- Textbausteine ---------- *@
        <aside class="bausteine @(_vm?.ZeigtUnterlagen == true ? "breit" : "")">
            @if (_vm is not null)
            {
                <div class="leistenwahl" role="tablist" aria-label="Inhalt der linken Leiste">
                    @foreach ((Leistenanzeige art, string text) in Leisten)
                    {
                        <button role="tab" aria-selected="@(_vm.Leiste == art ? "true" : "false")" class="@(_vm.Leiste == art ? "aktiv" : "")"
                                @onclick="() => _vm.Leiste = art">@text</button>
                    }
                </div>
            }
            @if (_vm is not null && _vm.ZeigtNormen)
            {
                <div class="leiste">
                    <button class="knopf leise" @onclick="() => _vm.NormenZurueckCommand.Execute(null)" disabled="@(!_vm.KannNormenZurueck)" title="Zurück">◀</button>
                    <button class="knopf leise" @onclick="() => _vm.NormenVorCommand.Execute(null)" disabled="@(!_vm.KannNormenVor)" title="Vor">▶</button>
                    <input type="search" placeholder="„§ 433 Abs. 2 BGB“, „GmbHG“ oder Suchbegriff" value="@_vm.NormenSuchtext"
                           @oninput="e => _vm.NormenSuchtext = e.Value as string ?? string.Empty" @onkeydown="NormenSucheTasteAsync"
                           title="Zitat: Norm mit hervorgehobener Stelle · Kürzel: Gesetz durchblättern · sonst Volltextsuche" />
                    <button class="knopf leise" @onclick="() => Los(_vm.NormenSuchenCommand)" disabled="@_vm.NormenBeschaeftigt">Suchen</button>
                    <button class="knopf leise" @onclick="() => Los(_vm.NormenVerzeichnisCommand)" title="Verzeichnis der Normensammlung">☰</button>
                </div>
            }
            @if (_vm is not null && _vm.ZeigtUnterlagen)
            {
                <div class="leiste klein">
                    @if (_vm.UnterlageInBearbeitung)
                    {
                        <button class="knopf haupt" @onclick="() => Los(_vm.UnterlageFertigCommand)">Fertig</button>
                        <button class="knopf leise" @onclick="() => Los(_vm.UnterlageVerwerfenCommand)">Verwerfen</button>
                    }
                    else
                    {
                        @if (_vm.UnterlageAnzeigen)
                        {
                            <button class="knopf leise" @onclick="MarkierungAlsBausteinAsync" title="Markierten Text als Baustein speichern">+ Baustein</button>
                        }
                        <button class="knopf leise" @onclick="() => Los(_vm.UnterlageBearbeitenCommand)" disabled="@(!_vm.KannUnterlageBearbeiten)"
                                title="@(_vm.KannUnterlageBearbeiten ? "Text als Markdown bearbeiten" : "Sachverhalt oder Lösung einzeln wählen")">Bearbeiten</button>
                        <button class="knopf leise" @onclick="() => Los(_vm.UnterlageImportierenCommand)" disabled="@_vm.KeineKlausur"
                                title="Aus Datei übernehmen (.md, .txt, .docx)">Datei @Laden …</button>
                    }
                </div>
                @if (_vm.UnterlageInBearbeitung)
                {
                    <textarea class="unterlagentext" spellcheck="true" lang="de" value="@_vm.UnterlagenEntwurf"
                              @oninput="e => _vm.UnterlagenEntwurf = e.Value as string ?? string.Empty"></textarea>
                    <p class="tipp">Markdown: # Überschrift · **fett** · *kursiv* · - Aufzählung · Leerzeile = neuer Absatz</p>
                }
                else if (_vm.UnterlageLeerSichtbar)
                {
                    <p class="leer">@_vm.UnterlageLeerHinweis
                        (<button class="verweis" @onclick="() => Los(_vm.KlausurinformationenVorbereitenCommand)">Klausurinformationen vorbereiten</button>)</p>
                }
                else
                {
                    <div class="leiste">
                        <input type="search" placeholder="Im Text suchen (Eingabe: nächster Treffer)" value="@_unterlagenSuche"
                               @oninput="UnterlagenSuchenAsync" @onkeydown="UnterlagenSucheTasteAsync" />
                        <span class="klein">@_unterlagenTreffer</span>
                    </div>
                    @* Sicher: MarkdownHtml übernimmt kein HTML aus dem Text und lässt nur http/https/mailto-Verweise zu. *@
                    <div class="unterlage @(_vm.HatSchema ? "sprungziele" : "")" lang="de"
                         title="@(_vm.HatSchema ? "Klick auf eine Überschrift: zur passenden Zeile im Reiter „Rohpunkte“" : null)">@((MarkupString)_vm.UnterlagenHtml)</div>
                }
            }
            else if (_vm is not null)
            {
                <div class="leiste">
                    <input id="f-suche" type="search" placeholder="Bausteine durchsuchen" value="@_vm.Suchtext"
                           @oninput="e => _vm.Suchtext = e.Value as string ?? string.Empty" @onkeydown="SucheTaste" />
                </div>
                <div class="leiste klein">
                    <button class="knopf leise" @onclick="() => Los(_vm.NeuerBausteinOhneBezugCommand)" disabled="@_vm.KeineKlausur">+ Baustein</button>
                    <button class="knopf leise" @onclick="() => Los(_vm.NeueGruppeOhneBezugCommand)" disabled="@_vm.KeineKlausur">+ Gruppe</button>
                    <button class="knopf leise" @onclick="() => Los(_vm.BausteinRueckgaengigCommand)" disabled="@(!_vm.KannRueckgaengig)" title="Letzte Änderung an den Bausteinen zurücknehmen">↶</button>
                </div>
                <div class="baum">
                    @if (_vm.KeineKlausur)
                    {
                        <p class="leer">Bitte zuerst eine Klausur wählen oder anlegen.</p>
                    }
                    else if (_vm.KeineBausteine)
                    {
                        <p class="leer">Noch keine Textbausteine. „+ Baustein“ legt einen an; ein Paket aus dem KI-Portal bringt fertige mit
                            (<button class="verweis" @onclick="() => Los(_vm.KlausurinformationenVorbereitenCommand)">Klausurinformationen vorbereiten</button>).</p>
                    }
                    else if (_vm.KeineTreffer)
                    {
                        <p class="leer">Keine Treffer.</p>
                    }
                    else
                    {
                        <BausteinBaum Elemente="@(_vm.Umsortierbar ? _vm.Bausteine : _vm.Treffer)" Vm="_vm" Nachlauf="@Nachlauf" />
                    }
                </div>
                <p class="tipp">Klick fügt ein · Kürzel + Tab im Text fügt ein</p>
            }
        </aside>

        @* ---------- Gutachten ---------- *@
        <main class="mitte">
            @if (_vm is not null)
            {
                <section class="angaben">
                    <div class="feldgruppe">
                        <label for="f-student">@_vm.KennungsBezeichnung</label>
                        <input id="f-student" list="teilnehmende" value="@_vm.Student" @onchange="e => StudentSetzen(e.Value as string)" autocomplete="off" />
                        <datalist id="teilnehmende">
                            @foreach (Teilnehmer t in _vm.TeilnehmerVorschlaege(_vm.Student))
                            {
                                <option value="@t.ToString()"></option>
                            }
                        </datalist>
                    </div>
                    @if (_vm.MatrikelSichtbar)
                    {
                        <div class="feldgruppe">
                            <label for="f-matrikel">Matrikelnummer</label>
                            <input id="f-matrikel" value="@_vm.Matrikel" @onchange="e => _vm.Matrikel = e.Value as string ?? string.Empty" />
                        </div>
                    }
                    <label class="schalter"><input type="checkbox" checked="@_vm.Anonym" @onchange="e => _vm.Anonym = e.Value is true" /> anonym</label>
                    <div class="feldgruppe">
                        <label for="f-note">Note</label>
                        <select id="f-note" value="@_vm.NotenIndex" @onchange="e => _vm.NotenIndex = int.Parse((string)e.Value!, CultureInfo.InvariantCulture)">
                            @for (int i = 0; i < _vm.NotenAuswahl.Count; i++)
                            {
                                <option value="@i">@_vm.NotenAuswahl[i]</option>
                            }
                        </select>
                    </div>
                    <div class="feldgruppe schmal">
                        <label for="f-seiten">Seiten</label>
                        <input id="f-seiten" type="number" min="0" step="1" value="@ZahlText(_vm.Seiten)" @onchange="e => _vm.Seiten = Math.Max(0, ZahlLesen(e.Value as string, 0))" />
                    </div>
                    <div class="aktionen">
                        <button class="knopf" @onclick="_vm.NeueArbeit" title="Eingaben für die nächste Arbeit leeren">Nächste Arbeit</button>
                        <button class="knopf haupt" @onclick="() => Los(_vm.GenerierenCommand)" disabled="@_vm.KeineKlausur">Gutachten erstellen</button>
                    </div>
                    @if (_vm.ErstnoteSichtbar)
                    {
                        <div class="hinweiszeile erstnote @(_vm.ErstnoteAbweichend ? "abweichend" : "")"
                             title="Erstnoten aus dem Paket; Warnung ab 4 Punkten Abweichung">@(_vm.ErstnoteAbweichend ? "⚠ " : "")@_vm.ErstnoteText
                            @if (_vm.HatErstnote)
                            {
                                <button class="verweis" @onclick="() => Los(_vm.ErstgutachtenZustimmenCommand)"
                                        title="Erstnote übernehmen und „@MainViewModel.Zustimmungssatz“ einfügen">Einverstanden</button>
                            }
                        </div>
                    }
                    @if (_vm.InBearbeitung)
                    {
                        <div class="hinweiszeile">@_vm.BearbeitungsHinweis</div>
                    }
                </section>

                @if (_vm.HatKriterien || _vm.TeilpunkteSichtbar || _vm.HatNotenvorschlag)
                {
                    <section class="bewertung">
                        @foreach (KriteriumAuswahl k in _vm.Kriterien)
                        {
                            <div class="feldgruppe">
                                <label>@k.Name</label>
                                <select value="@k.Index" @onchange="e => k.Index = int.Parse((string)e.Value!, CultureInfo.InvariantCulture)">
                                    @for (int i = 0; i < k.Optionen.Count; i++)
                                    {
                                        <option value="@i">@k.Optionen[i]</option>
                                    }
                                </select>
                            </div>
                        }
                        @if (_vm.TeilpunkteSichtbar)
                        {
                            @foreach (AufgabenPunkte a in _vm.Aufgaben)
                            {
                                <div class="feldgruppe schmal">
                                    <label title="@a.Kopf">@a.Kopf</label>
                                    <input type="number" min="0" max="@ZahlText(a.Maximum)" step="0.25" value="@ZahlText(a.Punkte)"
                                           @onchange="e => a.Punkte = ZahlLesen(e.Value as string, double.NaN)" />
                                </div>
                            }
                            <div class="punktetext">@_vm.PunkteText</div>
                        }
                        @if (_vm.HatNotenvorschlag)
                        {
                            <button class="knopf leise" @onclick="() => Los(_vm.NotenvorschlagUebernehmenCommand)">Vorschlag übernehmen: @_vm.Notenvorschlag Punkte</button>
                        }
                    </section>
                }

                <div class="reiter">
                    <button class="@(_reiter == 0 ? "aktiv" : "")" @onclick="() => ReiterSetzen(0)">Gutachten</button>
                    @if (_vm.HatSchema)
                    {
                        <button class="@(_reiter == 1 ? "aktiv" : "")" @onclick="() => ReiterSetzen(1)">Rohpunkte @if (_vm.RohpunkteKurz is { } kurz) { <span class="kurz">@kurz</span> }</button>
                    }
                    <span class="abstand"></span>
                    @if (_reiter == 0)
                    {
                        <button class="format" title="Fett (Strg+B)" @onclick='() => Editor.FormatierenAsync("bold")'><b>F</b></button>
                        <button class="format" title="Kursiv (Strg+I)" @onclick='() => Editor.FormatierenAsync("italic")'><i>K</i></button>
                    }
                </div>
            }

            @* Der Editor ist immer vorhanden: das ViewModel setzt den Entwurf schon beim Start. *@
            <div class="editorrahmen @(_reiter == 0 ? "" : "verborgen")">
                <div id="@EntwurfEditor.ElementId" class="editor" contenteditable="true" spellcheck="true" lang="de"
                     data-platzhalter="Gutachtentext – Bausteine links anklicken oder Kürzel + Tab"></div>
            </div>

            @if (_vm is not null && _vm.HatSchema && _reiter == 1)
            {
                <RohpunkteReiter Vm="_vm" Nachlauf="@Nachlauf" KommentarGewaehlt="@((int n) => _kommentarZeile = n)" />
            }
        </main>

        @* ---------- Übersicht ---------- *@
        @if (_vm is not null && _vm.SeitenleisteOffen)
        {
            <Uebersicht Vm="_vm" Nachlauf="@Nachlauf" />
        }
    </div>

    <footer class="fuss">
        @if (_vm is null)
        {
            <span>Lade gespeicherte Daten …</span>
        }
        else
        {
            <span>@(_vm.KeineKlausur ? "Keine Klausur" : _vm.KlausurName)</span>
            @if (_vm.RohpunkteKurz is { } rp)
            {
                <span>· @rp</span>
            }
            <span class="abstand"></span>
            @if (!Plattform.ImBrowser)
            {
                <span title="@_vm.AblageordnerText">Ablage: @_vm.AblageordnerText</span>
            }
            @if (Plattform.Fehler is { } f)
            {
                <span class="fehlertext" title="@f">Speichern fehlgeschlagen</span>
            }
            else if (Plattform.Stand is { } stand)
            {
                <span>@stand</span>
            }
        }
    </footer>
</div>

@code {
    MainViewModel? _vm;
    int _phase;
    int _reiter;
    string? _menue;
    int? _kommentarZeile;
    (double Belegt, double Verfuegbar)? _belegung;
    Timer? _takt;
    DotNetObjectReference<EntwurfEditor>? _editorRef;
    DotNetObjectReference<Hauptseite>? _seitenRef;

    /// <summary>Wortlaut der Menüpunkte: im Browser herunter- bzw. hochladen, auf dem Mac öffnen bzw. laden.</summary>
    string Oeffnen => Plattform.ImBrowser ? "herunterladen" : "öffnen";
    string Laden => Plattform.ImBrowser ? "hochladen" : "laden";

    static string Fassung =>
        typeof(MainViewModel).Assembly.GetName().Version?.ToString(3) ?? string.Empty;

    protected override void OnInitialized()
    {
        Ui.Geaendert += Neuzeichnen;
        Ui.RohpunkteGewuenscht += () => { _reiter = 1; Neuzeichnen(); };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _editorRef = DotNetObjectReference.Create(Editor);
            await Js.InvokeVoidAsync("gutachtentool.editor.anmelden", EntwurfEditor.ElementId, _editorRef);
            try
            {
                await Plattform.StartAsync();
            }
            catch (JSException ex)
            {
                Ui.Melden(Meldungsart.Fehler, "Browserspeicher nicht verfügbar",
                    "Im privaten Modus oder bei gesperrtem Speicher bleiben Eingaben nicht erhalten. " + ex.Message);
            }
            _vm = new MainViewModel(Ui, Editor);
            _vm.PropertyChanged += VmGeaendert;
            _vm.UeberschriftAnspringen += UeberschriftAnspringen;
            _vm.NormAnspringen += NormAnspringen;
            Editor.Geaendert = _vm.EntwurfGeaendert;
            Editor.AnderesZiel = InAnmerkungEinfuegen;
            _phase = 1;
            StateHasChanged();
            return;
        }
        if (_phase == 1 && _vm is not null)
        {
            _phase = 2;
            _vm.Initialisieren();
            // Im Browser bedeutet „Öffnen“ Herunterladen: das erstellte Gutachten wird stets heruntergeladen.
            if (Plattform.ImBrowser) _vm.WordOeffnen = true;
            await Nachlauf();
            _seitenRef = DotNetObjectReference.Create(this);
            await Js.InvokeVoidAsync("gutachtentool.beimVerlassen", _seitenRef);
            await Js.InvokeVoidAsync("gutachtentool.verweiseAbfangen", _seitenRef);
            await Js.InvokeVoidAsync("gutachtentool.unterlage.anmelden", _seitenRef);
            _takt = new Timer(_ => _ = InvokeAsync(TaktAsync), null, 3000, 3000);
            // Mac: per Doppelklick geöffnete Pakete (auch das, mit dem das Programm gestartet wurde)
            Plattform.DateienAbonnieren(pfad => InvokeAsync(async () =>
            {
                if (_vm is null) return;
                await _vm.PaketImportierenAsync(pfad);
                await Nachlauf();
            }));
        }
    }

    void VmGeaendert(object? sender, PropertyChangedEventArgs e)
    {
        if (e.PropertyName == nameof(MainViewModel.HatSchema) && _vm?.HatSchema == false) _reiter = 0;
        Neuzeichnen();
    }

    void Neuzeichnen() => _ = InvokeAsync(StateHasChanged);

    async Task TaktAsync()
    {
        if (_vm is null) return;
        _vm.Autosave();
        await Plattform.NachlaufAsync();
        StateHasChanged();
    }

    /// <summary>Verweise in Sachverhalt/Lösung (Mac: Standardbrowser; Browser: neuer Tab).</summary>
    [JSInvokable]
    public async Task VerweisOeffnen(string adresse)
    {
        if (!Uri.TryCreate(adresse, UriKind.Absolute, out Uri? u) || u.Scheme is not ("https" or "http" or "mailto")) return;
        try
        {
            await Plattform.OeffnenAsync(u.ToString());
        }
        catch (Exception ex)
        {
            EinstellungsSpeicher.Protokollieren(ex);
        }
    }

    // ---------- Seitenleiste: Suche, Baustein aus Markierung, Sprung zur Rohpunktzeile ----------

    string _unterlagenSuche = string.Empty, _unterlagenTreffer = string.Empty;

    async Task UnterlagenSuchenAsync(ChangeEventArgs e)
    {
        _unterlagenSuche = e.Value as string ?? string.Empty;
        _unterlagenTreffer = await Js.InvokeAsync<string>("gutachtentool.unterlage.suchen", _unterlagenSuche, 0);
    }

    async Task UnterlagenSucheTasteAsync(KeyboardEventArgs e)
    {
        if (e.Key != "Enter") return;
        _unterlagenTreffer = await Js.InvokeAsync<string>("gutachtentool.unterlage.suchen", _unterlagenSuche, e.ShiftKey ? -1 : 1);
    }

    async Task MarkierungAlsBausteinAsync()
    {
        if (_vm is null) return;
        string text = await Js.InvokeAsync<string>("gutachtentool.unterlage.auswahl");
        if (text.Length == 0)
        {
            Ui.Melden(Meldungsart.Information, "Nichts markiert", "Bitte zuerst Text in Sachverhalt oder Lösung markieren.");
            return;
        }
        await _vm.NeuerBausteinAsync(text, null);
        await Nachlauf();
    }

    [JSInvokable]
    public async Task UeberschriftGewaehlt(string ueberschrift)
    {
        if (_vm is null || !_vm.HatSchema) return;
        int index = _vm.RohpunktzeileZuUeberschrift(ueberschrift);
        if (index < 0)
        {
            Ui.Melden(Meldungsart.Information, "Keine passende Rohpunktzeile", $"Zu „{ueberschrift}“ gibt es im Rohpunkteschema keine ähnliche Überschrift.");
            return;
        }
        _reiter = 1;
        StateHasChanged();
        await Task.Yield();
        await Js.InvokeVoidAsync("gutachtentool.rohpunktZeigen", RohpunkteReiter.ZeilenId(index));
    }

