    /// <summary>Nach jeder Aktion: Downloads ausliefern, Daten sichern, neu zeichnen.</summary>
    async Task Nachlauf()
    {
        await Plattform.NachlaufAsync();
        if (_vm is not null) await Editor.KuerzelMeldenAsync(_vm.Bausteine);
        StateHasChanged();
    }

    async Task Los(ICommand befehl)
    {
        _menue = null;
        try
        {
            if (befehl is IAsyncRelayCommand a)
            {
                if (a.CanExecute(null)) await a.ExecuteAsync(null);
            }
            else if (befehl.CanExecute(null))
            {
                befehl.Execute(null);
            }
        }
        catch (Exception ex)
        {
            EinstellungsSpeicher.Protokollieren(ex);
            Ui.Melden(Meldungsart.Fehler, "Fehler", ex.Message);
        }
        await Nachlauf();
    }

    void MenueUmschalten(string name)
    {
        _menue = _menue == name ? null : name;
        if (_menue == "daten") _ = BelegungAktualisierenAsync();
    }

