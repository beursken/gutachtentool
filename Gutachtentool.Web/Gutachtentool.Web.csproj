<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <!-- Browser-Fassung des Gutachtentools (Blazor WebAssembly). Läuft vollständig im Browser;
       alle Daten bleiben im Browserspeicher (IndexedDB) des Rechners. Kern: Gutachten2025.Core. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Gutachtentool.Web</RootNamespace>
    <Version>1.3.0</Version>
    <Product>Gutachtentool</Product>
    <Company>Universität Passau</Company>
    <!-- Deutsche Zahlen-, Datums- und Sortierregeln unabhängig von der Browsersprache -->
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
    <!-- Einstellungen, Klausur.json und Pakete werden per Reflection (System.Text.Json) gelesen -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <!-- Nur Framework-Bibliotheken kürzen; Kern und Open XML SDK bleiben vollständig -->
    <TrimMode>partial</TrimMode>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.*" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.*" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gutachten2025.Core\Gutachten2025.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="Gutachten2025.Core" />
    <TrimmerRootAssembly Include="DocumentFormat.OpenXml" />
    <TrimmerRootAssembly Include="DocumentFormat.OpenXml.Framework" />
  </ItemGroup>

  <!-- Offline-Betrieb (installierbare Web-App) -->
  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>
</Project>
