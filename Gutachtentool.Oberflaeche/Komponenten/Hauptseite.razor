    {
        if (Plattform is IBrowserSicherung s) _belegung = await s.BelegungAsync();
        StateHasChanged();
    }

    void ReiterSetzen(int reiter)
    {
        _reiter = reiter;
        if (reiter == 0) _kommentarZeile = null;
    }

    /// <summary>Im Reiter „Rohpunkte“ gehen Bausteine in die zuletzt gewählte Anmerkung.</summary>
    bool InAnmerkungEinfuegen(string text)
    {
        if (_vm is null || _reiter != 1 || _kommentarZeile is not int n || n >= _vm.Rohpunktzeilen.Count) return false;
        RohpunktZeile z = _vm.Rohpunktzeilen[n];
        if (!z.IstEingabe) return false;
        // Am Ende der Anmerkung anfügen (wie beim Einfügen in den Entwurf mit Leerzeichen und Satzpunkt).
        string bisher = string.Concat(z.Kommentar.Select(l => l.T));
        string praefix = bisher.Length > 0 && !char.IsWhiteSpace(bisher[^1]) ? " " : string.Empty;
        string suffix = text[^1] is '.' or '!' or '?' or ':' ? " " : ". ";
        z.KommentarVomEditor(new List<TextLauf> { new(bisher + praefix + text + suffix) });
        Neuzeichnen();
        return true;
    }

