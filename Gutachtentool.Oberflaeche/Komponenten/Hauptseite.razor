    async void UeberschriftAnspringen(string begriff)
    {
        try
        {
            await InvokeAsync(StateHasChanged);
            await Task.Delay(50); // neu gezeichnete Leiste abwarten
            bool gefunden = await Js.InvokeAsync<bool>("gutachtentool.unterlage.ueberschriftZeigen", begriff);
            if (!gefunden) Ui.Melden(Meldungsart.Information, "Nicht in der Lösung gefunden", $"„{begriff}“ kommt in der Lösung nicht vor.");
        }
        catch (JSException ex)
        {
            EinstellungsSpeicher.Protokollieren(ex);
        }
    }

    async void NormAnspringen(string zitat, bool nurUeberschrift)
    {
        try
        {
            await InvokeAsync(StateHasChanged);
            await Task.Delay(50); // neu gezeichnete Leiste abwarten
            await Js.InvokeVoidAsync("gutachtentool.unterlage.normZeigen", zitat, nurUeberschrift);
        }
        catch (JSException ex)
        {
            EinstellungsSpeicher.Protokollieren(ex);
        }
    }

